# Copy to .env and fill in real values. Do not commit .env.
HWCLOUD_USERNAME=your-account
HWCLOUD_PASSWORD=your-password
XIZHI_KEY=your-xizhi-key

# Docker only
NOVNC_PASSWORD=change-me
NOVNC_PUBLIC_URL=http://192.168.1.10:6080/vnc.html?autoconnect=1&resize=scale
GROW_NO_SANDBOX=true
TZ=Asia/Shanghai

# Optional overrides
# GROW_CRON=0 0 8 * * *
# GROW_ZONE=Asia/Shanghai
# GROW_HUMAN_WAIT=10m
# GROW_HEADLESS=false
